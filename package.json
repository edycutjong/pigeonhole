{
  "name": "pigeonhole",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "tsx scripts/verify.ts",
    "lint": "oxlint src test scripts e2e --deny-warnings",
    "lint:fix": "oxlint src test scripts e2e --fix",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run audit && npm run lint && npm run typecheck && npm run test:coverage",
    "ci:full": "npm run ci && npm run build && npm run e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "npx @lhci/cli autorun",
    "security-scan": "npm audit --audit-level=high; gitleaks detect --no-banner --redact",
    "readiness": "python3 scripts/check_submission_readiness.py",
    "checkpoints": "tsx scripts/checkpoints.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "viem": "^2.56.7",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.1",
    "oxlint": "^1.83.0"
  },
  "version": "1.0.0"
}
